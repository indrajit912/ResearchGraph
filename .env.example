# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-secret-key-in-production

# Database
# Use postgresql in production: postgresql://user:password@localhost:5432/researchgraph
DATABASE_URL=sqlite:///researchgraph.db

# Hermes Email API
HERMES_API_URL=https://hermesbot.pythonanywhere.com
HERMES_API_KEY=your_hermes_api_key_here
HERMES_EMAILBOT_ID=your_hermes_bot_id_here
